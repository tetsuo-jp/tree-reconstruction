// based on algo_c4c (succeeded)

// A binary tree reconstruction, reversibly
// without a sentinel, from an i-p seq to a tree and an i-p seq
// An attempt to delete the visited[] array
// Tested on https://tetsuo.jp/janus-playground-180405

procedure mk_ip_seq(int root, int ip[], int n, int p[], int l[], int r[])
  local int i=0
  call mk_ip_seq_sub(root, 0, i, ip, n, p, l, r)
  delocal int i=n

procedure mk_ip_seq_sub(int root, int parent, int i, int ip[], int n, int p[], int l[], int r[])
  if root != 0 then
    ip[i] ^= root // zero clear
    p[root] ^= parent // zero clear
    i += 1
    call mk_ip_seq_sub(l[root], root, i, ip, n, p, l, r)
    call mk_ip_seq_sub(r[root], root, i, ip, n, p, l, r)
  fi root != 0

procedure reconstruct(int ip[], int n, int p[], int l[], int r[])
  local stack s = nil
  push(ip[0]+0,s)

  iterate int i = 1 to n-1
    if ip[i-1] > ip[i] then // grafting left child
      l[ip[i-1]] ^= ip[i]
      p[ip[i]] ^= ip[i-1]
    else // grafting right child
      local int x
      pop(x,s)
      r[x] ^= ip[i]
      p[ip[i]] <=> x // zero clear x
      delocal int x
    fi ip[i-1] > ip[i]
    if l[ip[i]+1] = 0 then
      push(ip[i]+0,s)
    fi l[ip[i]+1] = 0
  end
  pop(n+0,s)
  delocal stack s = nil

procedure main()
  //int n = 1
  //int ip[n+1] = {1}
  //int n = 2
  //int ip[n+1] = {1,2}
  //int n = 4
  //int ip[n+1] = {4,3,1,2}
  //int n = 5
  //int ip[n+1] = {3,1,2,4,5}
  int n = 8
  int ip[] = {4,2,1,3,6,5,8,7,0}

  int l[n+2]
  int r[n+2]
  int p[n+2]
  // int ip2[size(ip)]
  int root = ip[0]

  call reconstruct(ip, n, p, l, r)
  uncall mk_ip_seq(root, ip, n, p, l, r)
