// A binary tree reconstruction, reversibly
// without a sentinel, from an i-p seq to a tree and an i-p seq
// without a stack
// Tested on https://tetsuo.jp/janus-playground-180405

procedure reconstruct(int ip[], int n, int l[], int r[])
  local int h = 1

  iterate int i = 1 to n-1
    if ip[i-1] > ip[i] then // grafting left child
      l[ip[i-1]] ^= ip[i]
    else // grafting right child
      r[h] ^= ip[i]
      h += 1
    fi r[h-1] != ip[i] // l[ip[i-1]] = ip[i]
    if l[ip[i]+1] != 0 then
      ip[i] ^= h // zero clear
      h += 1
    fi l[h] != 0
  end
  delocal int h = n

procedure main()
  //int n = 1
  //int ip[n+1] = {1}
  //int n = 2
  //int ip[n+1] = {1,2}
  //int ip[n+1] = {2,1}
  //int n = 4
  //int ip[n+1] = {4,3,2,1}
  //int n = 5
  //int ip[n+1] = {3,1,2,4,5}
  int n = 8
  int ip[] = {4,2,1,3,6,5,8,7,-1}

  int l[n+2]
  int r[n+2]

  call reconstruct(ip, n, l, r)
