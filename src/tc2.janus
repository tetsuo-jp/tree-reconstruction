// A binary tree reconstruction, reversibly, with a sentinel
// Tested on

procedure reconstruct(int ip[], int n, int p[], int l[], int r[], stack s)
  local int visited[n+1] = {0}
  visited[ip[0]] ^= 1
  push(ip[0], s)
  iterate int i = 1 to n-1
    if visited[ip[i]] = 0 then
      push(i+0,s)
    fi visited[ip[i]] = 0
    visited[ip[i]] ^= 1
    if ip[i-1] > ip[i] then
      l[i-1] ^= i
      p[i] ^= i-1
    else
      local int x
      pop(x,s)
      r[x] ^= i
      p[i] <=> x
      delocal int x
    fi ip[i-1] > ip[i]
  end
  iterate int i = 0 to n-1
    visited[i] ^= 1 // zero clear
  end
  delocal int visited[n+1] = {0}

procedure main()
  //int n = 1 + 2
  //int ip[] = {0,1,2}
  int n = 2 + 2
  //int ip[] = {0,1,2,3}
  int ip[] = {0,2,1,3}
  //int n = 5
  // int ip[] = {0,1,2,3,4}
  // int ip[] = {2,0,1,3,4}
  int p[n]
  int l[n]
  int r[n]
  stack s

  call reconstruct(ip, n, p, l, r, s)
