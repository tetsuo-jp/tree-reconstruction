// based on algo_c4c (failed)

// A binary tree reconstruction, reversibly
// without a sentinel, from an i-p seq to a tree and an i-p seq
// An attempt to delete the visited[] array
// Tested on https://tetsuo.jp/janus-playground-180405

procedure reconstruct(int ip[], int n, int l[], int r[])
  local stack s = nil, int h = 1
  if l[ip[0]+1]=0 then          // visited?
    push(ip[0]+0,s)
  fi l[ip[0]+1]=0

  iterate int i = 1 to n-1
    if ip[i-1] > ip[i] then // grafting left child
      l[ip[i-1]] ^= ip[i]
    else // grafting right child
      local int x
      pop(x,s)
      r[x] ^= ip[i]
      delocal int x = h
      h += 1
    fi ip[i-1] > ip[i]
    if l[ip[i]+1] = 0 then
      push(ip[i]+0,s)
    else
      h += 1
    fi l[ip[i]+1] = 0
  end
  pop(n+0,s)
  delocal stack s = nil, int h = n

procedure main()
  //int n = 1
  //int ip[n+1] = {1}
  //int n = 2
  //int ip[n+1] = {1,2}
  int n = 4
  int ip[n+1] = {4,3,1,2}
  //int n = 5
  //int ip[n+1] = {3,1,2,4,5}
  //int n = 8
  //int ip[] = {4,2,1,3,6,5,8,7,0}

  int l[n+2]
  int r[n+2]

  call reconstruct(ip, n, l, r)
