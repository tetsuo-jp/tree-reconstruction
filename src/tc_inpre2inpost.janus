// A binary tree reconstruction, reversibly
// without a sentinel, from an inorder-preorder seq to a tree and an inorder-preorder seq
// Tested on

procedure reconstruct(int ip[], int n, int l[], int r[], stack g)
  local stack s = nil, int visited[n+1]
  visited[ip[0]] ^= 1
  push(ip[0], s)
  iterate int i = 1 to n-1
    if ip[i-1] > ip[i] then // grafting left child
      l[ip[i-1]] ^= ip[i]
    else // grafting right child
      local int x
      pop(x,s)
      r[x] ^= ip[i]
      push(x,g)
      delocal int x
    fi ip[i-1] > ip[i]
    if visited[ip[i]+1] = 0 then
      push(ip[i],s)
    fi visited[ip[i]+1] = 0
    visited[ip[i]] ^= 1
  end
  iterate int i = 0 to n-1
    visited[i] ^= 1 // zero clear
  end
  pop(ip[n-1]+1,s) // clear s
  delocal stack s = nil, int visited[n+1]

procedure main()
  // int n = 1
  // int ip[] = {0}
  //int n = 2
  //int ip[] = {0,1}
  //int ip[] = {1,0}
  //int n = 5
  //int ip[] = {0,1,2,3,4}
  //int ip[] = {2,0,1,3,4}
  int n = 8
  int ip[] = {3,1,0,2,5,4,7,6}

  int l[n]
  int r[n]
  stack g

  call reconstruct(ip, n, l, r, g)
